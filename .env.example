# ==============================================================================
# DATABASE CONFIGURATION / НАСТРОЙКИ БАЗЫ ДАННЫХ (PostgreSQL)
# ==============================================================================

# Имя пользователя базы данных (используется при создании контейнера PostgreSQL)
# Database username (used when creating PostgreSQL container in Docker)
POSTGRES_USER=postgres

# Пароль для базы данных (укажите надежный пароль в продакшене)
# Database password (use a strong password in production)
POSTGRES_PASSWORD=your_secure_password

# Название базы данных для хранения постов, настроек и хэшей
# Database name for storing posts, settings, and deduplication hashes
POSTGRES_DB=tg_admin

# Асинхронная строка подключения к базе данных для SQLAlchemy (драйвер asyncpg)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Async PostgreSQL connection string for SQLAlchemy via asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@db:5432/tg_admin


# ==============================================================================
# TASK QUEUE & CACHE / ОЧЕРЕДЬ ЗАДАЧ И КЭШ (Redis)
# ==============================================================================

# Строка подключения к Redis для очереди задач Arq и временного кэша
# Format: redis://<HOST>:<PORT>/<DB_INDEX>
# Connection URL for Redis instance used by Arq task queue
REDIS_URL=redis://redis:6379/0


# ==============================================================================
# TELEGRAM MTPROTO API / КЛЮЧИ TELEGRAM API (Telethon Parser / Userbot)
# ==============================================================================

# Числовой App API ID, полученный на сайте https://my.telegram.org (раздел API development tools)
# Numeric App API ID from https://my.telegram.org (API development tools)
API_ID=12345678

# Строка App API Hash, полученная на сайте https://my.telegram.org (раздел API development tools)
# String App API Hash from https://my.telegram.org (API development tools)
API_HASH=abcdef0123456789abcdef0123456789

# Список каналов-доноров для сбора постов через запятую (числовые ID или юзернеймы)
# Примеры: -1001234567890 (ID канала), @channel_username, channel_username
# Donor channels to monitor. Comma-separated list of channel IDs or usernames.
CHANNELS_TO_TRACK=-1001234567890,@channel_username,donor_channel


# ==============================================================================
# TELEGRAM BOT SETTINGS / НАСТРОЙКИ БОТА МОДЕРАЦИИ
# ==============================================================================

# Токен Telegram-бота, полученный у @BotFather
# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID целевого канала, куда бот будет публиковать одобренные посты (начинается с -100...)
# Бот ОБЯЗАТЕЛЬНО должен быть добавлен в этот канал администратором с правом публикации
# Target channel ID where approved posts are published (must start with -100...)
TARGET_CHANNEL_ID=-1001234567890

# ID группы/супергруппы модераторов, куда бот присылает карточки на проверку (начинается с -100...)
# Если оставить пустым (""), карточки будут приходить в личные сообщения первому администратору
# Moderator group/supergroup ID. If empty, cards are sent to the first admin DM
MODERATOR_CHAT_ID=-1001987654321

# Список Telegram ID администраторов через запятую (только они имеют доступ к командам бота)
# Узнать свой числовой ID можно у бота @userinfobot в Telegram
# Comma-separated list of authorized admin Telegram User IDs (check via @userinfobot)
ADMIN_IDS=123456789,987654321


# ==============================================================================
# AI PROVIDER SETTINGS / НАСТРОЙКИ НЕЙРОСЕТИ (LLM)
# ==============================================================================

# API-ключ провайдера нейросети (OpenAI, DeepSeek, OpenRouter, Mistral, Groq и др.)
# API Key for your LLM provider (OpenAI, DeepSeek, OpenRouter, etc.)
AI_API_KEY=sk-proj-your-api-key-here

# Базовый URL API (оставьте по умолчанию для OpenAI либо укажите URL провайдера/прокси)
# Примеры: https://api.openai.com/v1 | https://api.deepseek.com/v1 | https://openrouter.ai/api/v1
# Base URL for OpenAI-compatible endpoint
AI_BASE_URL=https://api.openai.com/v1

# Название модели нейросети для рерайта и кураторства
# Model name used for rewriting and curation (e.g. gpt-4o-mini, deepseek-chat, gpt-4o)
AI_MODEL=gpt-4o-mini

# Стоп-слова и фразы для автоматической фильтрации рекламы (через запятую, регистронезависимо)
# Посты с этими словами сразу помечаются как реклама и не тратят токены нейросети
# Stop-words for automatic ad/spam filtering. Matching posts are dropped before AI rewrite
AD_KEYWORDS=реклама,erid,промокод,подписывайтесь,скидка,розыгрыш,подписаться,promo,sponsored

# Дополнительные параметры для запроса к нейросети в формате JSON (например, температура генерации)
# Extra payload passed to OpenAI chat completions in JSON format
OPENAI_EXTRA_BODY={"temperature": 0.7}


# ==============================================================================
# INTERFACE LOCALIZATION / ЯЗЫК ИНТЕРФЕЙСА
# ==============================================================================

# Язык интерфейса бота по умолчанию: ru (русский) или en (английский)
# Default bot UI language: ru (Russian) or en (English)
LANGUAGE=ru
